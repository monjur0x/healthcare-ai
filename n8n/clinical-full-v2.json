    {
      "parameters": {
        "jsCode": "const patient=$('1.Receive Patient Data').first().json.body.patient||{};\nconst analyst=$('3.Patient Analyst').first().json||{};\nconst pred=$('4.Disease Predictor').first().json||{};\nlet evidence=[];\ntry{const rag=$('5.Medical Researcher').all();evidence=rag.map(r=>({document_id:r.json.document_id||'',source:r.json.source||'',score:r.json.score||0,text:(r.json.text||'').substring(0,200)}));}catch(e){}\nconst treat=$('6.Treatment Planner').first().json||{};\nconst explain=$('7.Explainability Expert').first().json||{};\nreturn [{json:{status:'success',patient,input_type:'csv',\npatient_summary:analyst.patient_summary||'',\nprediction:{predicted_class:pred.predicted_class||'',probabilities:pred.probabilities||{},confidence:pred.confidence||0},\nrisk:{risk_score:pred.risk_score||0,risk_level:pred.risk_level||'unknown',risk_factors:pred.risk_factors||[]},\nevidence,recommendations:treat.recommendations||[],monitoring_schedule:treat.monitoring_schedule||[],\nexplanation:explain.explanation||'',limitations:'AI decision support tool.',doctor_notice:'AI-assisted report.',\nstored:true,stored_at:new Date().toISOString()}}];"
      },
      "id": "n09",
      "name": "Assemble Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
