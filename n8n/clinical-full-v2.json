    {
      "parameters": {
        "jsCode": "const pred=$json;\nconst parts=[];\nif(pred.risk_factors&&pred.risk_factors.length)parts.push(pred.risk_factors.join(' '));\nif(pred.predicted_class==='1')parts.push('diabetes treatment');\nelse parts.push('healthy lifestyle');\nreturn [{json:{query:parts.join(' ')}}];"
      },
