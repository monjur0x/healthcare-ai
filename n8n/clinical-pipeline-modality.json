        "url": "http://localhost:8000/api/v1/analyze",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { patient: $json.patient, features: $json.features, markers: $json.markers, recommendations: $json.recommendations, input_type: 'image' } }}",
        "options": {}
      },
