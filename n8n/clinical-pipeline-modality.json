        "options": {}
      },
      "id": "10db9984-b42d-400c-a6b1-30d5a94b2553",
      "name": "Merge: Append Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [640, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = items.map((i) => {\n  const r = i.json || {};\n  return {\n    patient_id: (r.patient && r.patient.id) || null,\n    input_type: r.input_type || null,\n    prediction: r.prediction ? r.prediction.predicted_class : null,\n    confidence: r.prediction ? r.prediction.confidence : null,\n    risk_level: r.risk ? r.risk.risk_level : null,\n    evidence_count: Array.isArray(r.evidence) ? r.evidence.length : 0,\n  };\n});\nreturn [{ json: { status: 'success', request_id: $execution.id, result_count: results.length, results } }];"
      },
      "id": "0e4b7eb1-25ca-44a2-bb36-9dabe07749e2",
      "name": "Code: Summarize Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "9d7abcf8-d3ba-4eec-a3ef-1d94742fe982",
      "name": "Respond to Webhook (Success)",
