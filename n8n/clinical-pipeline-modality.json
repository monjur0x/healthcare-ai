      "id": "bb17f2b4-933a-4ffd-9e97-3961e3b40565",
      "name": "Webhook: Receive Patient Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-340, 300],
      "webhookId": "e13764d8-6bc6-46e1-8d6f-70cab20d41dd"
    },
    {
      "parameters": {
        "jsCode": "const body = ($json && ($json.body || $json)) || {};\nreturn [{ json: {\n  patient: body.patient || { id: body.patient_id || 'unknown' },\n  features: body.features || {},\n  markers: body.markers || null,\n  recommendations: body.recommendations || null,\n  modality: String(body.modality || 'csv').toLowerCase(),\n} }];"
      },
      "id": "ea0906b0-38fa-4800-bb94-27a10e40255b",
      "name": "Code: Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-100, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "={{ $json.modality }}",
                  "type": "string"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.modality }}",
                    "rightValue": "image",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameExpression": "Image Input"
            }
          ]
        },
        "fallbackOutput": 1,
        "options": {}
      },
      "id": "79df113d-643e-444d-af64-b0ce4e682c5c",
      "name": "Switch: Route by Modality",
