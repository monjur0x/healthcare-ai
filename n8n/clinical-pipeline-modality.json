      "id": "688cd200-123a-4de2-a848-05ff74df2ab4",
      "name": "Merge: Append Errors",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [640, 540]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst errors = items.map((i) => {\n  const resp = i.json || {};\n  const detail = resp.detail || (resp.body && resp.body.detail) || null;\n  const raw = (detail && (detail.message || detail.code))\n    || resp.message || resp.error\n    || (resp.body && (resp.body.message || resp.body.error))\n    || 'The clinical analysis API request failed';\n  return { stage: resp.input_type || 'analysis_call', error_message: typeof raw === 'string' ? raw : JSON.stringify(raw) };\n});\nreturn [{ json: { status: 'error', request_id: $execution.id, error_count: errors.length, errors } }];"
      },
      "id": "dfaf8de3-7feb-4cf4-8dc8-b563218c7cc9",
