    {
      "parameters": {
        "jsCode": "const resp = $json || {};\nconst valid = typeof resp === 'object'\n  && resp.patient && typeof resp.patient === 'object'\n  && typeof resp.patient_summary === 'string'\n  && Array.isArray(resp.evidence);\nconst summary = valid ? {\n  request_id: $execution.id,\n  patient_id: (resp.patient && resp.patient.id) || null,\n  input_type: resp.input_type || null,\n  prediction: resp.prediction ? resp.prediction.predicted_class : null,\n  confidence: resp.prediction ? resp.prediction.confidence : null,\n  risk_level: resp.risk ? resp.risk.risk_level : null,\n  risk_factors: resp.risk ? (resp.risk.risk_factors || []) : [],\n  evidence_count: resp.evidence.length,\n  recommendation_count: Array.isArray(resp.recommendations) ? resp.recommendations.length : 0,\n} : null;\nreturn [{ json: {\n  valid,\n  reason: valid ? '' : 'The API response is not a valid clinical report',\n  summary,\n  report: resp,\n} }];"
      },
      "id": "32425fa3-3db9-4aba-bcab-4bb86fcc9d53",
      "name": "Code: Validate & Summarize",
      "type": "n8n-nodes-base.code",
