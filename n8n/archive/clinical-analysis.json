      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [860, 180]
    },
    {
      "parameters": {
        "jsCode": "const resp = $json || {};\nconst detail = resp.detail || (resp.body && resp.body.detail) || null;\nconst raw = (detail && (detail.message || detail.code))\n  || resp.message || resp.error\n  || (resp.body && (resp.body.message || resp.body.error))\n  || 'The clinical analysis API request failed';\nconst msg = typeof raw === 'string' ? raw : JSON.stringify(raw);\nreturn [{ json: { status: 'error', stage: 'analysis_call', error_message: msg } }];"
      },
      "id": "be5ecd2d-f07c-4aad-a57d-31ea5b5193c9",
      "name": "Code: Format Call Error",
      "type": "n8n-nodes-base.code",
