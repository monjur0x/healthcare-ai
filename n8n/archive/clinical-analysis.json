      "typeVersion": 2.3,
      "position": [380, 300]
    },
    {
      "parameters": {
        "jsCode": "const s = $json.summary || {};\nreturn [{ json: {\n  status: 'success',\n  ...s,\n  report: $json.report,\n} }];"
      },
      "id": "75727f44-dc7b-4cf8-b726-e42def1dc95e",
