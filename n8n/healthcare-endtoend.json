        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { patient: $('Webhook: End-to-End Pipeline').item.json.body.patient, features: $('Webhook: End-to-End Pipeline').item.json.body.features, markers: $('Webhook: End-to-End Pipeline').item.json.body.markers, recommendations: $('Webhook: End-to-End Pipeline').item.json.body.recommendations, input_type: $('Webhook: End-to-End Pipeline').item.json.body.input_type || 'csv' } }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "e2e00000-0000-4000-8000-000000000005",
      "name": "HTTP: Analyze Patient",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
