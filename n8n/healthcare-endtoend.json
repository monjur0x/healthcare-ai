    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL || 'http://127.0.0.1:8000' }}/api/v1/train",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { preset: $json.body.preset, dataset: $json.body.dataset, target: $json.body.target, model: $json.body.model, test_size: $json.body.test_size, seed: $json.body.seed, max_rows: $json.body.max_rows, federated: $json.body.federated, clients: $json.body.clients, rounds: $json.body.rounds } }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "e2e00000-0000-4000-8000-000000000004",
      "name": "HTTP: Train Model",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-280, 80],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "VyBag3RC9YxWb3PI",
          "name": "Healthcare API Token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
