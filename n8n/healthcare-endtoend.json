    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DOCTOR_NOTIFY_WEBHOOK }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { alert: 'high_risk', request_id: $json.request_id, dataset: $json.dataset, patient: $json.report.patient, risk_level: $json.risk_level, confidence: $json.confidence, prediction: $json.prediction, recommendation: ($json.report.recommendations || []).slice(0, 3), notified_at: new Date().toISOString() } }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "e2e00000-0000-4000-8000-000000000013",
      "name": "HTTP: Notify Doctor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 60],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const report = $('IF: High Risk?').item.json;\nreturn [{ json: { ...report, notified: true } }];"
      },
      "id": "e2e00000-0000-4000-8000-000000000014",
      "name": "Code: Pass Report After Notify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 60]
    },
    {
      "parameters": {
        "jsCode": "const resp = $json || {};\nconst detail = resp.detail || (resp.body && resp.body.detail) || null;\nconst raw = (detail && (detail.message || detail.code))\n  || resp.message || resp.error\n  || (resp.body && (resp.body.message || resp.body.error))\n  || 'The train request failed';\nconst msg = typeof raw === 'string' ? raw : JSON.stringify(raw);\nreturn [{ json: { status: 'error', stage: 'train_call', error_message: msg } }];"
      },
      "id": "e2e00000-0000-4000-8000-00000000000a",
      "name": "Code: Format Train Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-40, 520]
    },
