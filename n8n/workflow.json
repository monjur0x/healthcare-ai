      "id": "a7bf5708-9ccf-4391-bf07-55ff362a461a",
      "name": "Call CrewAI Healthcare Crew",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        192
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const e = $json || {};\nconst raw = e.error || e.message || (e.body && (e.body.error || e.body.message));\nconst msg = typeof raw === 'string' ? raw : (raw ? JSON.stringify(raw) : 'CrewAI FastAPI request failed');\nreturn [{ json: {\n  status: 'error',\n  stage: 'crewai_call',\n  error_message: msg,\n  crew_response: null,\n} }];"
      },
      "id": "1399a86a-9493-4f91-91cf-48725ccbe31a",
      "name": "Format Call Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        384
      ]
    },
    {
      "parameters": {},
      "id": "898ae8fa-5f2f-4c47-949e-9e07028dc8a7",
      "name": "Merge Error Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1120,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const resp = item.json;\n  let valid = true;\n  let reason = '';\n  if (resp === null || typeof resp !== 'object' || Array.isArray(resp)) {\n    valid = false; reason = 'CrewAI response is not a JSON object';\n  } else if (Object.keys(resp).length === 0) {\n    valid = false; reason = 'CrewAI response is empty';\n  } else if (resp.error || resp.status === 'error' || resp.success === false) {\n    valid = false; reason = typeof resp.error === 'string' ? resp.error : 'CrewAI reported an error status';\n  }\n  out.push({ json: { valid, reason, crew_response: resp } });\n}\nreturn out;"
      },
      "id": "30edad08-ef4c-42e3-8c1c-b1acf6bfe726",
      "name": "Validate CrewAI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
