    {
      "parameters": {
        "formTitle": "Healthcare Crew Intake",
        "formDescription": "Upload patient CSV data, an optional medical image, and patient metadata to run the CrewAI Healthcare Crew.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Patient Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Patient ID",
              "requiredField": true
            },
            {
              "fieldLabel": "Patient Age",
              "fieldType": "number"
            },
            {
              "fieldLabel": "Clinical Notes",
              "fieldType": "textarea"
            },
            {
              "fieldLabel": "CSV Data File",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".csv",
              "requiredField": true
            },
            {
              "fieldLabel": "Medical Image",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".png,.jpg,.jpeg,.dcm"
            }
          ]
        },
        "options": {
          "path": "healthcare-crew-intake",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Submission received. The CrewAI Healthcare Crew is processing your case."
            }
          }
        }
