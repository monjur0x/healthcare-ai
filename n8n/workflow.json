    {
      "parameters": {
        "jsCode": "const LF = String.fromCharCode(10);\nconst resp = $json.crew_response;\nconst patient = $('Healthcare Intake Form').item.json['Patient Name'] || 'Unknown';\nconst patientId = $('Healthcare Intake Form').item.json['Patient ID'] || 'N/A';\nconst body = [\n  'CrewAI Healthcare Crew Report',\n  '=============================',\n  'Patient: ' + patient,\n  'Patient ID: ' + patientId,\n  'Generated: ' + new Date().toISOString(),\n  'Execution: ' + $execution.id,\n  '',\n  'Raw CrewAI Response (unmodified):',\n  JSON.stringify(resp, null, 2),\n].join(LF);\nreturn [{ json: {\n  report_title: 'CrewAI Healthcare Report - ' + patient + ' - ' + patientId,\n  report_body: body,\n  crew_response: resp,\n} }];"
      },
