# Healthcare AI backend configuration.
#
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# The `.env` file is read by pydantic-settings from the backend working
# directory (all config modules use `env_file=".env"`). Never commit
# `.env` — it is gitignored. Values can also be passed as environment
# variables; anything set here can be overridden by the shell.

# ---------------------------------------------------------------------------
# API  (prefix API_  -> backend/api/config.py)
# ---------------------------------------------------------------------------

# Path to a trained tabular model artifact (joblib). When empty, the
# service reports models as unavailable until /api/v1/train is called.
# API_MODEL_PATH=

# Path to a trained image model artifact (torch, ImageClassifier). When
# empty, the image-analysis endpoint returns 503 until set.
# API_IMAGE_MODEL_PATH=

# Directory containing the medical corpus for RAG. When empty, the
# repository's bundled corpus (backend/rag/corpus/) is used.
# API_CORPUS_DIR=

# Where trained artifacts are written (default: "artifacts").
# API_ARTIFACTS_DIR=artifacts

# Directory containing datasets for /api/v1/train.
# API_DATASET_DIR=/home/monjur0x0/dataset

# Optional bearer token. When set, all /api/v1 routes require it.
# API_TOKEN=

# Comma-separated CORS allowed origins (default "*").
# API_CORS_ALLOW_ORIGINS=*

# ---------------------------------------------------------------------------
# Federation  (prefix FED_ -> backend/federated/config.py)
# ---------------------------------------------------------------------------

# Flower gRPC server address for distributed runs (default 0.0.0.0:8080).
# FED_SERVER_ADDRESS=0.0.0.0:8080
# FED_REGISTRY_PATH=artifacts/federation.db

# Root directory holding per-hospital local CSV slices
# (default data/hospitals).
# FED_HOSPITALS_DIR=data/hospitals

# Directory containing preset datasets for hospital site partitioning.
# Falls back to DATASET_DIR when empty.
# FED_DATASET_DIR=/home/monjur0x0/dataset

# Where distributed global model artifacts are written
# (default artifacts).
# FED_ARTIFACTS_DIR=artifacts

# Fixed seed for hospital partitioning + secure aggregation (default 42).
# FED_SEED=42

# ---------------------------------------------------------------------------
# Feedback / retrain loop  (prefix FEEDBACK_ -> backend/feedback/config.py)
# ---------------------------------------------------------------------------

# SQLite feedback store path (default artifacts/feedback.db).
# FEEDBACK_DB_PATH=artifacts/feedback.db

# Minimum pending samples required before a retrain is allowed per preset
# (default 5).
# FEEDBACK_RETRAIN_THRESHOLD=5

# Allow feedback-driven retraining (default true). Set false to keep
# recording feedback while disabling automated retrains.
# FEEDBACK_RETRAIN_ENABLED=true

# ---------------------------------------------------------------------------
# CrewAI orchestration  (prefix CREW_ -> backend/CrewAI/orchestrator/config.py)
# ---------------------------------------------------------------------------

# LLM provider used by the optional agent path. "google" is the default
# and maps to crewai's ChatGoogleGenerativeAI.
CREW_LLM_PROVIDER=google

# Google Gemini model used by the agents. gemini-3.7-flash is the
# current workhorse model (see Google AI docs for availability).
CREW_LLM_MODEL=gemini-3.7-flash

# Google AI Studio / Gemini API key. When unset, the crew runs the
# deterministic offline pipeline (no LLM) — set this to enable the
# agentic path (ClinicalCrew.run_llm). Get a key from:
#   https://aistudio.google.com/apikey
CREW_LLM_API_KEY=

# Sampling temperature for agent reasoning (default 0.3).
# CREW_LLM_TEMPERATURE=0.3

# Max iterations for agent tasks (default 10).
# CREW_LLM_MAX_ITERATIONS=10

# Verbose crew execution (default false).
# CREW_VERBOSE=false

# CrewAI memory (default false).
# CREW_MEMORY=false

# Top-k retrieved evidence chunks (default 3).
# RAG_TOP_K=3

# Risk band thresholds applied to the predicted probability of the
# disease (positive) class (defaults 0.3 / 0.6). A confident prediction
# of the healthy class scores low risk; the positive class probability
# drives the level.
# RISK_LOW_THRESHOLD=0.3
# RISK_MEDIUM_THRESHOLD=0.6

# ---------------------------------------------------------------------------
# Models  (prefix MODEL_ -> backend/models/config.py)
# ---------------------------------------------------------------------------

# Fixed random seed for reproducibility (default 42).
# MODEL_RANDOM_SEED=42

# Image CNN training defaults.
# MODEL_IMAGE_TRAIN_EPOCHS=10
# MODEL_IMAGE_TRAIN_BATCH_SIZE=16
# MODEL_IMAGE_TRAIN_LEARNING_RATE=0.001
# MODEL_IMAGE_DEVICE=auto

# ---------------------------------------------------------------------------
# RAG  (prefix RAG_ -> backend/rag/config.py)
# ---------------------------------------------------------------------------

# Embedding model; "tfidf" is the lightweight default. Opt-in
# "sentence-transformer" (dense; downloads BAAI/bge-small-en-v1.5 on
# first use).
# RAG_EMBEDDING_MODEL=tfidf
# RAG_SENTENCE_TRANSFORMER_MODEL=BAAI/bge-small-en-v1.5

# Vector store backend: "memory" (in-process NumPy, default) or "chroma"
# (persistent ChromaDB collection).
# RAG_VECTOR_STORE=memory

# Directory for the persistent ChromaDB collection when
# RAG_VECTOR_STORE=chroma (empty = ephemeral per process).
# RAG_CHROMA_PERSIST_DIR=

# ChromaDB collection name (default "healthcare_rag").
# RAG_CHROMA_COLLECTION=healthcare_rag

# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=64
# RAG_MAX_FEATURES=5000
# RAG_TOP_K=5
# RAG_SIMILARITY_METRIC=cosine