# Environment Variables for Healthcare AI Backend
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME=Healthcare AI Backend
APP_VERSION=1.0.0
DEBUG=false

# LLM Configuration (Google Gemini)
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your_google_gemini_api_key_here
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=medical_knowledge
QDRANT_API_KEY=

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# File Upload Settings
MAX_FILE_SIZE_MB=50

# Risk Thresholds
RISK_LOW_THRESHOLD=0.3
RISK_MEDIUM_THRESHOLD=0.6
RISK_HIGH_THRESHOLD=0.8

# Crew Configuration
CREW_VERBOSE=true
CREW_MAX_ITERATIONS=10
CREW_MEMORY=true

# Federated Learning Configuration
FL_NUM_HOSPITALS=4
FL_NUM_ROUNDS=10
FL_LOCAL_EPOCHS=3
FL_BATCH_SIZE=64
FL_LEARNING_RATE=0.01
FL_CLIENT_FRACTION=1.0
FL_MODEL_TYPE=mlp
FL_ARTIFACT_DIR=artifacts
FL_DATA_DIR=data

# Differential Privacy Configuration
DP_ENABLED=true
DP_EPSILON_TARGET=4.0
DP_DELTA=1e-5
DP_MAX_GRAD_NORM=1.0
DP_NOISE_MULTIPLIER=1.1
